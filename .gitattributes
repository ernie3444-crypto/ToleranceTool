# Normalize line endings: text files LF in the repo, native on checkout.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.props   text
*.targets text
*.xml     text
*.md      text
*.html    text
*.dna     text

# Binary
*.xll   binary
*.png   binary
*.jpg   binary
*.xlsx  binary
*.accdb binary
