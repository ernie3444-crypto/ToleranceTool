<Window x:Class="ToleranceTool.Wpf.Tolerances.ToleranceTermWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tt="clr-namespace:ToleranceTool.Wpf"
        Title="Tolerance term" Height="340" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary Source="/ToleranceTool.Wpf;component/Theme.xaml" />
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="84" Margin="4,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="84" Margin="4,0" IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Kind" Margin="0,0,10,0" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />

            <Label Grid.Row="1" Grid.Column="0" Content="Value" Margin="0,0,10,0"
                   Visibility="{Binding ShowValue, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Value}"
                     Visibility="{Binding ShowValue, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />

            <Label Grid.Row="2" Grid.Column="0" Content="Basis" Margin="0,0,10,0"
                   Visibility="{Binding ShowBasis, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BasisOptions}" SelectedItem="{Binding Basis}"
                      Visibility="{Binding ShowBasis, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />

            <Label Grid.Row="3" Grid.Column="0" Content="Space" Margin="0,0,10,0"
                   Visibility="{Binding ShowSpace, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SpaceOptions}" SelectedItem="{Binding Space}"
                      Visibility="{Binding ShowSpace, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />

            <Label Grid.Row="4" Grid.Column="0" Content="Unit" Margin="0,0,10,0"
                   Visibility="{Binding ShowUnit, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Unit}"
                     Visibility="{Binding ShowUnit, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />

            <Label Grid.Row="5" Grid.Column="0" Content="Unit system" Margin="0,0,10,0"
                   Visibility="{Binding ShowUnitSystem, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding UnitSystems}" SelectedItem="{Binding UnitSystem}"
                      Visibility="{Binding ShowUnitSystem, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />

            <Label Grid.Row="6" Grid.Column="0" Content="Expression" Margin="0,0,10,0" VerticalAlignment="Top"
                   Visibility="{Binding ShowExpression, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Expression}" AcceptsReturn="True" MinHeight="46"
                     FontFamily="Consolas"
                     Visibility="{Binding ShowExpression, Converter={x:Static tt:VisibleWhenConverter.Instance}}" />

            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Hint}" Text="{Binding HintText}" Margin="0,6,0,0" />
        </Grid>
    </DockPanel>
</Window>
