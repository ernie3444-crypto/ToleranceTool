<Window x:Class="ToleranceTool.Wpf.Tolerances.AddDefinitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New tolerance" Height="150" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary Source="/ToleranceTool.Wpf;component/Theme.xaml" />
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="84" Margin="4,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="84" Margin="4,0" IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="Signal type" Margin="0,0,10,0" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="SignalTypeBox" />
            <Label Grid.Row="1" Grid.Column="0" Content="Module type" Margin="0,0,10,0" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ModuleTypeBox" />
        </Grid>
    </DockPanel>
</Window>
