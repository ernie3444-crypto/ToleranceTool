<Window x:Class="ToleranceTool.Wpf.Scales.ScaleTypeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tt="clr-namespace:ToleranceTool.Wpf"
        Title="Scale Type Editor" Height="620" Width="980" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary Source="/ToleranceTool.Wpf;component/Theme.xaml" />
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <ToolBar DockPanel.Dock="Top">
            <Button Content="Add" Command="{Binding AddCommand}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" />
            <Separator />
            <Button Content="Load…" Command="{Binding LoadCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <Button Content="Save As…" Command="{Binding SaveAsCommand}" />
            <Separator />
            <Button Content="Validate" Command="{Binding ValidateCommand}" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" Foreground="#555" />
        </StatusBar>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Scale types" FontWeight="Bold" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding ScaleTypes}"
                         SelectedItem="{Binding Selected}"
                         DisplayMemberPath="Name" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#EEE" />

            <Grid Grid.Column="2" IsEnabled="{Binding Selected, Converter={x:Static tt:NotNullConverter.Instance}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" MinHeight="80" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Name" />
                <TextBox Grid.Row="0" Margin="60,2,0,4" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Row="1">
                    <Label Content="Forward   euFrac → rawFrac" />
                    <TextBox Text="{Binding Selected.Forward, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                    <Label Content="Inverse   rawFrac → euFrac" />
                    <TextBox Text="{Binding Selected.Inverse, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </StackPanel>

                <Label Grid.Row="3" Content="Parameters" Margin="0,6,0,0" />

                <DataGrid Grid.Row="4" ItemsSource="{Binding Selected.Parameters}" AutoGenerateColumns="False"
                          CanUserAddRows="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch" Background="#EEE" />

                <Border Grid.Row="6" BorderBrush="#DDD" BorderThickness="1" Background="White" Margin="0,4,0,0">
                    <Grid ClipToBounds="True">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleY="-1" />
                        </Grid.LayoutTransform>
                        <Polyline Points="{Binding ReferencePoints}" Stroke="#CCC" StrokeThickness="1"
                                  Stretch="Fill" Margin="8" />
                        <Polyline Points="{Binding ForwardPoints}" Stroke="RoyalBlue" StrokeThickness="2"
                                  Stretch="Fill" Margin="8" />
                        <Polyline Points="{Binding InversePoints}" Stroke="SeaGreen" StrokeThickness="2"
                                  Stretch="Fill" Margin="8" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="7" Text="{Binding ValidationText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{Binding IsValid, Converter={x:Static tt:ValidBrushConverter.Instance}}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
