  <ItemGroup>
    <ProjectReference Include="..\ToleranceTool.Core\ToleranceTool.Core.csproj" />
    <ProjectReference Include="..\ToleranceTool.Configuration\ToleranceTool.Configuration.csproj" />
  </ItemGroup>

</Project>
