<?xml version="1.0" encoding="utf-8"?>
<!-- Starter scale-type library. Copy to %APPDATA%\ToleranceTool\scale-types.xml
     Each curve is two expressions over a normalized variable x in [0, 1]:
       Forward : euFraction  -> rawFraction
       Inverse : rawFraction -> euFraction
     Every curve must satisfy Forward(0)=0, Forward(1)=1 and be monotonic. -->
<ScaleTypes>

  <ScaleType name="Linear">
    <Forward>x</Forward>
    <Inverse>x</Inverse>
  </ScaleType>

  <!-- Differential-pressure flow: measured flow (EU) vs. DP (raw). -->
  <ScaleType name="SquareRoot">
    <Forward>Pow(x, 2)</Forward>
    <Inverse>Sqrt(x)</Inverse>
  </ScaleType>

  <ScaleType name="Logarithmic">
    <Param name="decades" value="2" />
    <Forward>(Pow(10, x * decades) - 1) / (Pow(10, decades) - 1)</Forward>
    <Inverse>Log10(x * (Pow(10, decades) - 1) + 1) / decades</Inverse>
  </ScaleType>

</ScaleTypes>
